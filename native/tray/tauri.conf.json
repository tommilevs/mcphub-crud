{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MCPHub",
  "version": "1.1.8",
  "identifier": "com.mcphub.desktop",
  "build": { "frontendDist": "../../frontend/dist", "devUrl": "http://localhost:5173" },
  "app": {
    "windows": [{ "title": "MCPHub", "width": 1280, "height": 800, "visible": false }],
    "security": { "csp": null },
    "trayIcon": { "iconPath": "icons/icon.ico", "tooltip": "MCPHub" }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.ico"],
    "resources": {
      "../target/release/mcphub-runtime-service.exe": "mcphub-runtime-service.exe",
      "../staging/node.exe": "runtime/node.exe",
      "../staging/dist": "runtime/dist",
      "../staging/frontend": "runtime/frontend",
      "../staging/node_modules": "runtime/node_modules"
    },
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "displayLanguageSelector": true,
        "installerHooks": "windows/hooks.nsh"
      }
    }
  }
}
