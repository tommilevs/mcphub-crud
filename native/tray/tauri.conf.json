{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MCPHub",
  "version": "1.1.8",
  "identifier": "com.mcphub.desktop",
  "build": { "frontendDist": "../../frontend/dist", "devUrl": "http://localhost:5173" },
  "app": {
    "windows": [],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.ico"],
    "resources": {
      "../target/release/mcphub-runtime-service.exe": "mcphub-runtime-service.exe",
      "windows/runtime-install.ps1": "runtime-install.ps1",
      "../staging/node.exe": "runtime/node.exe",
      "../staging/package.json": "runtime/package.json",
      "../staging/dist": "runtime/dist",
      "../staging/frontend": "runtime/frontend",
      "../staging/node_modules": "runtime/node_modules"
    },
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "displayLanguageSelector": true,
        "installerHooks": "windows/hooks.nsh"
      }
    }
  }
}
