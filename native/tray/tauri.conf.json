{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MCPHub",
  "version": "1.1.8",
  "identifier": "com.mcphub.desktop",
  "build": { "frontendDist": "../../frontend/dist", "devUrl": "http://localhost:5173" },
  "app": {
    "windows": [{ "title": "MCPHub", "width": 1280, "height": 800, "visible": false }],
    "security": { "csp": null },
    "trayIcon": { "iconPath": "../../frontend/favicon.ico", "tooltip": "MCPHub" }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": ["../service/target/release/mcphub-runtime-service.exe"],
    "windows": { "nsis": { "installMode": "perMachine", "displayLanguageSelector": true } }
  }
}
